// Copiar para conf/import/login_conf.txt no servidor de producao.
// Protege contra tentativas repetidas sem registrar senhas no VibeGuard.
ipban_enable: yes
ipban_dynamic_pass_failure_ban: yes
ipban_dynamic_pass_failure_ban_interval: 5
ipban_dynamic_pass_failure_ban_limit: 7
ipban_dynamic_pass_failure_ban_duration: 15
ipban_cleanup_interval: 60

