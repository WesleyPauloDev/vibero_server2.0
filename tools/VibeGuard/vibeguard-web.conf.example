// Import these settings from conf/web_athena.conf for the local laboratory.
// Observation mode never blocks login, disconnects, jails or bans.
bind_ip: 127.0.0.1
vibeguard_observation_enabled: yes
vibeguard_manifest_sha256: 9e128603301b69e61b83191e1a2b1480976f12edadd8b96f293d64f3752e7e97
vibeguard_heartbeat_seconds: 10
vibeguard_session_ttl_seconds: 45
vibeguard_log_path: ./log/vibeguard-observation.log
