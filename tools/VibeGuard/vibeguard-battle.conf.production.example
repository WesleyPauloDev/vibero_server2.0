// VibeGuard production settings for conf/import/battle_conf.txt.
// Start with mode 1 until the web endpoint is reachable from an external client.
// Change to mode 2 only after that validation.
vibeguard_enforcement_mode: 1
vibeguard_warning_seconds: 30
vibeguard_grace_seconds: 90
vibeguard_heartbeat_ttl_seconds: 60
vibeguard_exempt_group_level: 1
